    {FilmId: "Jak rozpętałem drugą wojnę światową|1969", Tytul: "Jak rozpętałem drugą wojnę światową", Rezyser: "Tadeusz Chmielewski", Rok: 1969, Czas: 154, CzasText: "2 godz 34 min", Nastroje: "Komedia, Wojna", Cytat: "", Scena: "Niemiecki oficer każe mu przeliterować nazwisko: Grzegorz Brzęczyszczykiewicz, głoska po głosce.", Zdanie: "Franek Dolas przechodzi przez całą wojnę i wszędzie robi bałagan. Trzy części, jeden wieczór.", LinkFilmweb: "", DekadaKey: "60", DlugoscKey: "l"},
    {FilmId: "Rejs|1970", Tytul: "Rejs", Rezyser: "Marek Piwowski", Rok: 1970, Czas: 66, CzasText: "1 godz 6 min", Nastroje: "Komedia, PRL", Cytat: "Jak mi się coś nie podoba, to ja w ogóle nie zabieram głosu", Scena: "", Zdanie: "Statek płynie Wisłą, kadrowiec przejmuje władzę i system rozpuszcza się w improwizacji.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "s"},
    {FilmId: "Hydrozagadka|1970", Tytul: "Hydrozagadka", Rezyser: "Andrzej Kondratiuk", Rok: 1970, Czas: 65, CzasText: "1 godz 5 min", Nastroje: "Komedia, PRL", Cytat: "Komary rypią, wejdźmy do środka.", Scena: "", Zdanie: "Superbohater As broni Warszawy przed złodziejem wody. Absurd czystej próby.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "s"},
    {FilmId: "Brzezina|1970", Tytul: "Brzezina", Rezyser: "Andrzej Wajda", Rok: 1970, Czas: 99, CzasText: "1 godz 39 min", Nastroje: "Obyczajowe", Cytat: "", Scena: "Zielony las nakręcony jak obraz, w którym wszystko dojrzewa i gnije naraz.", Zdanie: "Dwaj bracia w leśnym domu: jeden umiera, drugi nie potrafi żyć.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Krajobraz po bitwie|1970", Tytul: "Krajobraz po bitwie", Rezyser: "Andrzej Wajda", Rok: 1970, Czas: 108, CzasText: "1 godz 48 min", Nastroje: "Wojna", Cytat: "", Scena: "Więźniowie w cudzych mundurach, którzy nie wiedzą, dokąd iść.", Zdanie: "Wyzwolony obóz, w którym wolność okazuje się trudniejsza od niewoli.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Trzecia część nocy|1971", Tytul: "Trzecia część nocy", Rezyser: "Andrzej Żuławski", Rok: 1971, Czas: 105, CzasText: "1 godz 45 min", Nastroje: "Wojna, Surrealizm", Cytat: "", Scena: "Ten sam mężczyzna spotykający dwie kobiety o jednej twarzy.", Zdanie: "Okupowany Lwów, karmienie wszy w instytucie i pamięć, która zaczyna się dublować.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Życie rodzinne|1971", Tytul: "Życie rodzinne", Rezyser: "Krzysztof Zanussi", Rok: 1971, Czas: 89, CzasText: "1 godz 29 min", Nastroje: "Obyczajowe", Cytat: "", Scena: "Podupadła willa z fabryką szkła, w której nikt nikogo nie słucha.", Zdanie: "Inżynier wraca do rozpadającego się domu rodzinnego i żałuje po dwóch godzinach.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "s"},
    {FilmId: "Nie lubię poniedziałku|1971", Tytul: "Nie lubię poniedziałku", Rezyser: "Tadeusz Chmielewski", Rok: 1971, Czas: 106, CzasText: "1 godz 46 min", Nastroje: "Komedia, PRL", Cytat: "Prawdziwy fachowiec nie zaczyna pracy w poniedziałek.", Scena: "", Zdanie: "Jeden poniedziałek w Warszawie i kilkanaście historii, które się o siebie zahaczają.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Perła w koronie|1971", Tytul: "Perła w koronie", Rezyser: "Kazimierz Kutz", Rok: 1971, Czas: 104, CzasText: "1 godz 44 min", Nastroje: "Kostium", Cytat: "", Scena: "Kobiety stojące pod szybem i czekające, aż ktoś wyjedzie na powierzchnię.", Zdanie: "Górnicy okupują kopalnię, a film cierpliwie pokazuje, czym jest wierność swoim.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Wesele|1972", Tytul: "Wesele", Rezyser: "Andrzej Wajda", Rok: 1972, Czas: 106, CzasText: "1 godz 46 min", Nastroje: "Kostium, Surrealizm", Cytat: "Miałeś, chamie, złoty róg", Scena: "", Zdanie: "Wyspiański wrzucony w wirówkę: jedna noc, chocholi taniec i cała polska mitologia.", LinkFilmweb: "https://www.filmweb.pl/film/Wesele-1972-1122", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Poszukiwany, poszukiwana|1972", Tytul: "Poszukiwany, poszukiwana", Rezyser: "Stanisław Bareja", Rok: 1972, Czas: 90, CzasText: "1 godz 30 min", Nastroje: "Komedia, PRL", Cytat: "", Scena: "Bohater w peruce, sprzątający mieszkania ludzi, którzy go szukają.", Zdanie: "Historyk sztuki ucieka przed fałszywym oskarżeniem, przebierając się za gosposię.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Sanatorium pod Klepsydrą|1973", Tytul: "Sanatorium pod Klepsydrą", Rezyser: "Wojciech Jerzy Has", Rok: 1973, Czas: 124, CzasText: "2 godz 4 min", Nastroje: "Surrealizm", Cytat: "", Scena: "Ojciec hodujący ptaki na strychu, w którym czas płynie wstecz.", Zdanie: "Schulz przeniesiony na ekran: czas się cofa, pokoje się mnożą, wszystko pięknie gnije.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "l"},
    {FilmId: "Iluminacja|1973", Tytul: "Iluminacja", Rezyser: "Krzysztof Zanussi", Rok: 1973, Czas: 91, CzasText: "1 godz 31 min", Nastroje: "Egzystencjalne", Cytat: "", Scena: "Wykresy i pomiary wtrącone w środek zwyczajnego ludzkiego życia.", Zdanie: "Fizyk szuka sensu i sprawdza po kolei naukę, miłość i religię. Żadna nie wystarcza.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Wniebowzięci|1973", Tytul: "Wniebowzięci", Rezyser: "Andrzej Kondratiuk", Rok: 1973, Czas: 78, CzasText: "1 godz 18 min", Nastroje: "Komedia, Surrealizm", Cytat: "", Scena: "Piwo pite na szczycie miasta, z którego wszystko wygląda inaczej.", Zdanie: "Dwaj przyjaciele jeżdżą windą na dach wieżowca i żyją tam po swojemu.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "s"},
    {FilmId: "Potop|1974", Tytul: "Potop", Rezyser: "Jerzy Hoffman", Rok: 1974, Czas: 315, CzasText: "5 godz 15 min", Nastroje: "Kostium", Cytat: "", Scena: "Kmicic wysadzający kolubrynę i wracający z niej jak z innego świata.", Zdanie: "Kmicic, Oleńka i pięć godzin szabli. Klasyka na cały deszczowy dzień.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "l"},
    {FilmId: "Nie ma mocnych|1974", Tytul: "Nie ma mocnych", Rezyser: "Sylwester Chęciński", Rok: 1974, Czas: 100, CzasText: "1 godz 40 min", Nastroje: "Komedia", Cytat: "Żyć nie umierać, chcą pracują, nie chcą nie pracują, demokracja człowieku!", Scena: "", Zdanie: "Kargule i Pawlaki, część druga: pojednanie idzie im równie ciężko jak wojna.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Ziemia obiecana|1975", Tytul: "Ziemia obiecana", Rezyser: "Andrzej Wajda", Rok: 1975, Czas: 179, CzasText: "2 godz 59 min", Nastroje: "Kostium", Cytat: "Ja nie mam nic, ty nie masz nic, on nie ma nic", Scena: "", Zdanie: "Trzech przyjaciół buduje fabrykę w Łodzi i po kolei sprzedaje wszystko, co mieli.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "l"},
    {FilmId: "Noce i dnie|1975", Tytul: "Noce i dnie", Rezyser: "Jerzy Antczak", Rok: 1975, Czas: 255, CzasText: "4 godz 15 min", Nastroje: "Kostium, Obyczajowe", Cytat: "", Scena: "Kobieta, która całe życie tęskni za innym życiem, i mąż, który to widzi.", Zdanie: "Saga o małżeństwie Barbary i Bogumiła, rozpisana na czterdzieści lat.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "l"},
    {FilmId: "Brunet wieczorową porą|1976", Tytul: "Brunet wieczorową porą", Rezyser: "Stanisław Bareja", Rok: 1976, Czas: 90, CzasText: "1 godz 30 min", Nastroje: "Komedia, PRL", Cytat: "Nie wiem, nie znam się, nie orientuję się, zarobiony jestem!", Scena: "", Zdanie: "Pomyłkowe morderstwo, sąsiedzi i cała PRL-owska logika załatwiania spraw.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Przepraszam, czy tu biją?|1976", Tytul: "Przepraszam, czy tu biją?", Rezyser: "Marek Piwowski", Rok: 1976, Czas: 84, CzasText: "1 godz 24 min", Nastroje: "Kryminał, PRL", Cytat: "Rozbieraj się! Tak od razu? Może najpierw buzi?", Scena: "", Zdanie: "Milicyjne śledztwo pokazane od kuchni, z humorem, od którego robi się nieprzyjemnie.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "s"},
    {FilmId: "Trędowata|1976", Tytul: "Trędowata", Rezyser: "Jerzy Hoffman", Rok: 1976, Czas: 103, CzasText: "1 godz 43 min", Nastroje: "Obyczajowe, Kostium", Cytat: "W naszej sferze zawsze będziesz trędowata.", Scena: "", Zdanie: "Melodramat wszech czasów: guwernantka, ordynat i rodzina, która nie pozwoli.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Człowiek z marmuru|1977", Tytul: "Człowiek z marmuru", Rezyser: "Andrzej Wajda", Rok: 1977, Czas: 165, CzasText: "2 godz 45 min", Nastroje: "PRL", Cytat: "", Scena: "Gigantyczny posąg murarza wyciągany z magazynu odrzuconych bohaterów.", Zdanie: "Studentka rozgrzebuje historię murarza-przodownika i odkopuje mechanizm propagandy.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "l"},
    {FilmId: "Barwy ochronne|1977", Tytul: "Barwy ochronne", Rezyser: "Krzysztof Zanussi", Rok: 1977, Czas: 106, CzasText: "1 godz 46 min", Nastroje: "PRL, Egzystencjalne", Cytat: "", Scena: "Motyle nabite na szpilki jako komentarz do całej reszty filmu.", Zdanie: "Obóz naukowy i pojedynek dwóch asystentów o to, ile trzeba oddać, żeby awansować.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Wodzirej|1977", Tytul: "Wodzirej", Rezyser: "Feliks Falk", Rok: 1977, Czas: 100, CzasText: "1 godz 40 min", Nastroje: "PRL", Cytat: "", Scena: "Próba mikrofonu, przy której widać całą hierarchię miasta.", Zdanie: "Prowincjonalny konferansjer depcze wszystkich po drodze do prowadzenia jednego balu.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Kochaj albo rzuć|1977", Tytul: "Kochaj albo rzuć", Rezyser: "Sylwester Chęciński", Rok: 1977, Czas: 107, CzasText: "1 godz 47 min", Nastroje: "Komedia", Cytat: "Nareszcie człowiek czuje się jak sołtys: wysoko, najedzony i za nic nie odpowiada.", Scena: "", Zdanie: "Kargul i Pawlak lecą do Ameryki i wywożą tam swoją sąsiedzką wojnę.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Bez znieczulenia|1978", Tytul: "Bez znieczulenia", Rezyser: "Andrzej Wajda", Rok: 1978, Czas: 131, CzasText: "2 godz 11 min", Nastroje: "PRL", Cytat: "", Scena: "Rozprawa rozwodowa, która wygląda jak proces polityczny.", Zdanie: "Znany dziennikarz z dnia na dzień traci żonę, pracę i miejsce w systemie.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "l"},
    {FilmId: "Aktorzy prowincjonalni|1978", Tytul: "Aktorzy prowincjonalni", Rezyser: "Agnieszka Holland", Rok: 1978, Czas: 104, CzasText: "1 godz 44 min", Nastroje: "PRL", Cytat: "", Scena: "Próba, na której aktor gra o wolność, nie mając jej nigdzie indziej.", Zdanie: "Prowincjonalny teatr wystawia „Wyzwolenie”, a za kulisami rozpada się wszystko.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Co mi zrobisz, jak mnie złapiesz|1978", Tytul: "Co mi zrobisz, jak mnie złapiesz", Rezyser: "Stanisław Bareja", Rok: 1978, Czas: 97, CzasText: "1 godz 37 min", Nastroje: "Komedia, PRL", Cytat: "Rozpoznałem pana po znaku rozpoznawczym.", Scena: "", Zdanie: "Dyrektor, kochanka i przedsiębiorstwo, w którym nic nie działa, ale wszystko się kręci.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Panny z Wilka|1979", Tytul: "Panny z Wilka", Rezyser: "Andrzej Wajda", Rok: 1979, Czas: 118, CzasText: "1 godz 58 min", Nastroje: "Obyczajowe, Kostium", Cytat: "", Scena: "Letnie popołudnia i rozmowy o tym, co się nie wydarzyło.", Zdanie: "Mężczyzna wraca po latach do domu, w którym pięć sióstr pamięta go inaczej.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Amator|1979", Tytul: "Amator", Rezyser: "Krzysztof Kieślowski", Rok: 1979, Czas: 117, CzasText: "1 godz 57 min", Nastroje: "PRL", Cytat: "", Scena: "Finał, w którym bohater obraca obiektyw w stronę samego siebie.", Zdanie: "Człowiek kupuje kamerę do nagrywania córki i traci wszystko, bo zaczyna filmować prawdę.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Paciorki jednego różańca|1979", Tytul: "Paciorki jednego różańca", Rezyser: "Kazimierz Kutz", Rok: 1979, Czas: 115, CzasText: "1 godz 55 min", Nastroje: "Obyczajowe", Cytat: "", Scena: "Jeden dom stojący sam wśród nowych bloków.", Zdanie: "Stary górnik nie chce się wyprowadzić z familoka, który idzie do rozbiórki.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Golem|1979", Tytul: "Golem", Rezyser: "Piotr Szulkin", Rok: 1979, Czas: 92, CzasText: "1 godz 32 min", Nastroje: "Fantastyka", Cytat: "", Scena: "Szara metropolia z głośnikami, które tłumaczą wszystkim, kim są.", Zdanie: "Świat po katastrofie, w którym człowiek nie wie, czy jest jeszcze człowiekiem.", LinkFilmweb: "", DekadaKey: "70", DlugoscKey: "m"},
    {FilmId: "Miś|1980", Tytul: "Miś", Rezyser: "Stanisław Bareja", Rok: 1980, Czas: 111, CzasText: "1 godz 51 min", Nastroje: "Komedia, PRL", Cytat: "Nie mamy pana płaszcza i co pan nam zrobi?", Scena: "", Zdanie: "Paszport, kasa i klub sportowy Tęcza: instrukcja obsługi PRL-u w formie komedii.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "m"},
    {FilmId: "Constans|1980", Tytul: "Constans", Rezyser: "Krzysztof Zanussi", Rok: 1980, Czas: 90, CzasText: "1 godz 30 min", Nastroje: "Egzystencjalne, PRL", Cytat: "", Scena: "Himalaje w marzeniach i drobne kombinacje w każdej realnej sprawie.", Zdanie: "Młody człowiek chce żyć uczciwie i przekonuje się, ile to kosztuje.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "m"},
    {FilmId: "Gorączka|1980", Tytul: "Gorączka", Rezyser: "Agnieszka Holland", Rok: 1980, Czas: 116, CzasText: "1 godz 56 min", Nastroje: "Kostium", Cytat: "", Scena: "Ładunek noszony w walizce jak przekleństwo, które trzeba komuś oddać.", Zdanie: "Bomba przechodzi z rąk do rąk wśród rewolucjonistów 1905 roku i niszczy każdego.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "m"},
    {FilmId: "Vabank|1981", Tytul: "Vabank", Rezyser: "Juliusz Machulski", Rok: 1981, Czas: 105, CzasText: "1 godz 45 min", Nastroje: "Kryminał, Komedia", Cytat: "Uśmiechniesz się tylko raz, gdy otworzysz kasę.", Scena: "", Zdanie: "Kasiarz wychodzi z więzienia i planuje zemstę tak elegancką, że aż chce się kibicować.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "m"},
    {FilmId: "Przypadek|1981", Tytul: "Przypadek", Rezyser: "Krzysztof Kieślowski", Rok: 1981, Czas: 122, CzasText: "2 godz 2 min", Nastroje: "PRL, Egzystencjalne", Cytat: "", Scena: "Bieg za odjeżdżającym pociągiem, powtórzony trzy razy z innym finałem.", Zdanie: "Trzy wersje jednego życia zależne od tego, czy bohater zdąży na pociąg.", LinkFilmweb: "https://www.filmweb.pl/film/Przypadek-1981-897", DekadaKey: "80", DlugoscKey: "l"},
    {FilmId: "Człowiek z żelaza|1981", Tytul: "Człowiek z żelaza", Rezyser: "Andrzej Wajda", Rok: 1981, Czas: 153, CzasText: "2 godz 33 min", Nastroje: "PRL", Cytat: "", Scena: "Kamera wpuszczona do stoczni w trakcie prawdziwych wydarzeń.", Zdanie: "Dziennikarz ma zniszczyć strajkującego stoczniowca, a kręci się to na jego oczach w historię.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "l"},
    {FilmId: "Wojna światów – następne stulecie|1981", Tytul: "Wojna światów – następne stulecie", Rezyser: "Piotr Szulkin", Rok: 1981, Czas: 92, CzasText: "1 godz 32 min", Nastroje: "Fantastyka, PRL", Cytat: "", Scena: "Studio telewizyjne jako jedyne okno na świat, w dodatku zakłamane.", Zdanie: "Telewizyjny gwiazdor kontra Marsjanie: najczarniejsza polska satyra na media.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "m"},
    {FilmId: "Konopielka|1981", Tytul: "Konopielka", Rezyser: "Witold Leszczyński", Rok: 1981, Czas: 90, CzasText: "1 godz 30 min", Nastroje: "Komedia, Obyczajowe", Cytat: "A Ziemia to okrągła jest, jak głowa!", Scena: "", Zdanie: "Do zabitej deskami wsi przyjeżdża nauczycielka i wszystko zaczyna się sypać.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "m"},
    {FilmId: "Przesłuchanie|1982", Tytul: "Przesłuchanie", Rezyser: "Ryszard Bugajski", Rok: 1982, Czas: 118, CzasText: "1 godz 58 min", Nastroje: "PRL", Cytat: "", Scena: "Cela, w której czas mierzy się kolejnymi przesłuchaniami.", Zdanie: "Kobieta trafia do stalinowskiego więzienia i nie podpisuje. Film leżał na półce siedem lat.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "m"},
    {FilmId: "Matka Królów|1982", Tytul: "Matka Królów", Rezyser: "Janusz Zaorski", Rok: 1982, Czas: 122, CzasText: "2 godz 2 min", Nastroje: "PRL", Cytat: "", Scena: "Pranie rozwieszane na podwórku, przez które przetacza się historia.", Zdanie: "Matka i czterej synowie przechodzą przez wojnę i stalinizm, tracąc po kolei wszystko.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "l"},
    {FilmId: "Austeria|1982", Tytul: "Austeria", Rezyser: "Jerzy Kawalerowicz", Rok: 1982, Czas: 109, CzasText: "1 godz 49 min", Nastroje: "Kostium", Cytat: "", Scena: "Chasydzki taniec o świcie, tuż przed nadejściem frontu.", Zdanie: "Jedna noc w karczmie u progu pierwszej wojny, gdy świat sztetla zbiera się ostatni raz.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "m"},
    {FilmId: "Znachor|1982", Tytul: "Znachor", Rezyser: "Jerzy Hoffman", Rok: 1982, Czas: 129, CzasText: "2 godz 9 min", Nastroje: "Obyczajowe", Cytat: "Wysoki sądzie, to jest profesor Rafał Wilczur.", Scena: "", Zdanie: "Melodramat totalny: profesor traci pamięć, odzyskuje ją i wszyscy płaczą.", LinkFilmweb: "https://www.filmweb.pl/film/Znachor-1981-1175", DekadaKey: "80", DlugoscKey: "l"},
    {FilmId: "Wielki Szu|1982", Tytul: "Wielki Szu", Rezyser: "Sylwester Chęciński", Rok: 1982, Czas: 92, CzasText: "1 godz 32 min", Nastroje: "Kryminał", Cytat: "Graliśmy uczciwie: ty oszukiwałeś, ja oszukiwałem, wygrał lepszy.", Scena: "", Zdanie: "Karciany szuler uczy młodszego fachu i przegrywa z własną legendą.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "m"},
    {FilmId: "Seksmisja|1984", Tytul: "Seksmisja", Rezyser: "Juliusz Machulski", Rok: 1984, Czas: 121, CzasText: "2 godz 1 min", Nastroje: "Komedia", Cytat: "Ciemność, widzę ciemność!", Scena: "", Zdanie: "Dwóch mężczyzn budzi się w świecie bez mężczyzn. Połowa dialogów weszła do języka.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "l"},
    {FilmId: "Vabank II, czyli riposta|1984", Tytul: "Vabank II, czyli riposta", Rezyser: "Juliusz Machulski", Rok: 1984, Czas: 91, CzasText: "1 godz 31 min", Nastroje: "Kryminał, Komedia", Cytat: "Kwinto, ty draniu, czekaj! To jeszcze nie koniec!", Scena: "", Zdanie: "Kramer wraca po zemstę, Kwinto odpowiada jeszcze bardziej wystudiowanym numerem.", LinkFilmweb: "", DekadaKey: "80", DlugoscKey: "m"},
